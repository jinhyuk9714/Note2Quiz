# ============================================================
# Note2Quiz Environment Variables
# Copy this file to .env and fill in the required values.
# ============================================================

# === Required ===

# Anthropic API key for quiz generation & semantic grading
ANTHROPIC_API_KEY=sk-ant-...

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quiznote

# === Optional (defaults shown) ===

# Debug mode — enables verbose logging, relaxes security checks
# DEBUG=false

# Claude model for quiz generation / grading / OCR
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Frontend URL — used for CORS and redirect links
# FRONTEND_BASE_URL=http://localhost:3000

# CORS allowed origins (JSON array)
# CORS_ORIGINS=["http://localhost:3000"]

# JWT token expiry in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# === Upload Limits ===

# Max upload file size in MB
# MAX_UPLOAD_SIZE_MB=20

# Max pages to process from a PDF
# MAX_PDF_PAGES=200

# === Rate Limiting ===

# Set to "false" to disable rate limiting
# RATE_LIMIT_ENABLED=true

# Auth endpoints rate limit
# RATE_LIMIT_AUTH=5/minute

# Quiz generation rate limit
# RATE_LIMIT_QUIZ_GEN=10/minute

# === LLM Resilience ===

# Request timeouts in seconds
# LLM_TIMEOUT_QUIZ=120.0
# LLM_TIMEOUT_GRADING=30.0
# LLM_TIMEOUT_OCR=120.0

# SDK-level retries for transient errors (429/500/503)
# LLM_MAX_RETRIES=2

# Circuit breaker: failures before opening
# LLM_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker: seconds before half-open
# LLM_CIRCUIT_BREAKER_COOLDOWN=60.0

# App-level per-chunk retry attempts
# LLM_CHUNK_RETRY_ATTEMPTS=2

# === Chunking ===

# DEFAULT_CHUNK_SIZE=1500
# DEFAULT_CHUNK_OVERLAP=200
# MAX_QUESTIONS_PER_CHUNK=5

# === Database Performance ===

# Log queries slower than this threshold (milliseconds)
# SLOW_QUERY_THRESHOLD_MS=500.0
