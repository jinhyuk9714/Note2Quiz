# === App ===
DEBUG=false
DOMAIN=note2quiz.com

# === Database ===
POSTGRES_USER=note2quiz
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=quiznote

# === Auth ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Email ===
# Options: "console" (log only), "smtp", "resend"
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@note2quiz.com
EMAIL_FROM_NAME=Note2Quiz
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# === Frontend ===
FRONTEND_BASE_URL=https://note2quiz.com
NEXT_PUBLIC_API_URL=https://note2quiz.com

# === CORS ===
CORS_ORIGINS=["https://note2quiz.com"]

# === Workers ===
WORKERS=2
LOG_LEVEL=info

# === Sentry (optional) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
