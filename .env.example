# Database (override for Docker; default connects to local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/quiznote

# Anthropic API (required for quiz generation)
ANTHROPIC_API_KEY=your-api-key-here

# JWT secret (change in production — use at least 32 random bytes)
JWT_SECRET_KEY=change-me-in-production

# Frontend API URL (baked into Next.js at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
